<?xml version="1.0" encoding="UTF-8"?>
<!--
  W1VO36.88-36-7  -  kernel workspace manifest
  - 11 repo yang punya branch android-16-release-w1vo36.88-36-7
  - + donor OPPO mt6896 (Android 16, kernel 6.12) untuk module yang tidak
    dipublikasikan Motorola

  Pakai:
    mkdir w1vo-kernel && cd w1vo-kernel
    repo init -u https://github.com/ramabondanp/w1vo36-kernel-manifest -b main
    repo sync -j8
-->
<manifest>
  <remote name="moto" fetch="https://github.com/MotorolaMobilityLLC" />
  <remote name="oppo" fetch="https://github.com/oppo-source" />
  <default revision="android-16-release-w1vo36.88-36-7" remote="moto" sync-j="8" />

  <!-- Kleaf (AOSP build/kernel) + entrypoint tools/bazel -->
  <project path="build/kernel" name="kernel-build-kernel">
    <linkfile src="kleaf/bazel.sh" dest="tools/bazel" />
    <linkfile src="kleaf/bzlmod/bazel.MODULE.bazel" dest="MODULE.bazel" />
    <linkfile src="kleaf/bzlmod/bazel.WORKSPACE.bzlmod" dest="WORKSPACE.bzlmod" />
  </project>

  <!-- AOSP bazel_common_rules (dipakai mgk.bzl: //build/bazel_common_rules/dist:dist.bzl) -->
  <project path="build/bazel_common_rules"
           name="kernel_platform-build-bazel_common_rules"
           remote="moto" revision="android-16-release-w2we36.56-98-2" />

  <!-- MTK MGK bazel rules -->
  <project path="build/bazel_mgk_rules" name="kernel-build-bazel_mgk_rules" />

  <!-- Full MTK ACK: Linux 6.12.38 + GKI android16-6.12-2025-09_r32 -->
  <project path="kernel-6.12" name="kernel-mtk" />

  <!-- Device modules (repo yang sudah dibersihkan dari kode Moto) -->
  <project path="kernel_device_modules-6.12" name="kernel-kernel_device_modules-6.12" />

  <!-- Module out-of-tree Motorola (moto_binder, moto_mm, utags, dll) -->
  <project path="motorola/kernel/modules" name="motorola-kernel-modules" />

  <!-- Vendor modules MTK yang punya branch w1vo -->
  <project path="vendor/mediatek/kernel_modules/gpu"
           name="vendor-mediatek-kernel_modules-gpu" />
  <project path="vendor/mediatek/kernel_modules/mtkcam"
           name="vendor-mediatek-kernel_modules-mtkcam" />
  <project path="vendor/mediatek/kernel_modules/connectivity/conninfra"
           name="vendor-mediatek-kernel_modules-connectivity-conninfra" />
  <project path="vendor/mediatek/kernel_modules/connectivity/bt/linux_v2"
           name="vendor-mediatek-kernel_modules-connectivity-bt-linux_v2" />
  <project path="vendor/mediatek/kernel_modules/connectivity/bt/mt66xx"
           name="vendor-mediatek-kernel_modules-connectivity-bt-mt66xx" />
  <project path="vendor/mediatek/kernel_modules/connectivity/wlan/core/gen4m"
           name="vendor-mediatek-kernel_modules-connectivity-wlan-core-gen4m" />

  <!-- Donor OPPO mt6896 (Android 16 / 6.12): pengisi module yang miss.
       Isi: connectivity/{common,connfem,gps,fmradio,wlan/adaptor,bt/*},
             afs_common_utils, hbt_driver, hbt_driver_cus, met_drv_v3,
             sched_cus, gpu, mtkcam, udc, met_drv_v2.
       Di-symlink oleh post-sync.sh. -->
  <project path="donor/oppo-mt6896"
           name="android_kernel_modules_oppo_mt6896"
           remote="oppo" revision="oppo/mt6896_b_16.0_reno12" />
</manifest>
