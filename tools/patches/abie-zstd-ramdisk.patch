+        private fun getZstdProg(): String {
+            if (zstdprog.isBlank()) {
+                zstdprog = "zstd"
+                if (isWindows) {
+                    try {
+                        Runtime.getRuntime().exec(arrayOf("tools/bin/zstd.exe", "--version"), null, null)
+                        zstdprog = "tools/bin/zstd.exe"
+                    } catch (e: Exception) {
+                        log.warn("zstd not installed")
+                    }
+                }
+            }
+            return zstdprog
+        }
+
+        val hasZstd: Boolean
+            get() : Boolean {
+                try {
+                    Runtime.getRuntime().exec(arrayOf(getZstdProg(), "--version"), null, null)
+                    log.debug("zstd available")
+                } catch (e: Exception) {
+                    log.warn("zstd not installed")
+                    return false
+                }
+                return true
+            }
+
+        /* magic number zstd: 28 B5 2F FD */
+        fun isZstd(compressedFile: String): Boolean {
+            return try {
+                Dumpling(compressedFile).readFully(0L..3L).contentEquals(
+                    byteArrayOf(0x28.toByte(), 0xB5.toByte(), 0x2F, 0xFD.toByte())
+                )
+            } catch (e: Exception) {
+                false
+            }
+        }
+
+        fun zstdcat(zstFile: String, outFile: String) {
+            "${getZstdProg()} -d -f -q $zstFile -o $outFile".check_call()
+        }
+
+        fun zstd(zstFile: String, inputStream: InputStream) {
+            FileOutputStream(File(zstFile)).use { fos ->
+                val baosE = ByteArrayOutputStream()
+                DefaultExecutor().let { exec ->
+                    exec.streamHandler = PumpStreamHandler(fos, baosE, inputStream)
+                    // -15: level tinggi tapi masih wajar untuk ramdisk puluhan MB
+                    val cmd = CommandLine.parse("${getZstdProg()} -15 -T0 -q -c")
+                    log.info(cmd.toString())
+                    exec.execute(cmd)
+                }
+                baosE.toByteArray().let {
+                    if (it.isNotEmpty()) {
+                        log.warn(String(it))
+                    }
+                }
+            }
+        }
+
