<?xml version="1.0" encoding="UTF-8"?>
<!--
  Overlay untuk manifest AOSP kernel:

    repo init -u https://android.googlesource.com/kernel/manifest \
              -b common-android16-6.12-2025-09
    cp local_manifest.xml .repo/local_manifests/w1vo.xml
    repo sync -j16

  Mengganti kernel/common dan kernel/build AOSP dengan versi MTK w1vo,
  total 6 project (5 repo Motorola w1vo/w2we + 1 repo terpadu
  alps-vendor_mediatek_kernel_modules yang sudah menggabungkan 6 repo
  vendor MTK Motorola, 13 modul donor OPPO mt6896, serta port GPU Mali
  r54p1 dan kamera X6871).

  Tidak ada tag <default> di sini karena manifest AOSP sudah punya;
  revision/remote ditulis per project.
-->
<manifest>
  <remote name="moto" fetch="https://github.com/MotorolaMobilityLLC" />
  <remote name="alps" fetch="https://github.com/ramabondanp" />

  <remove-project name="kernel/common" />
  <remove-project name="kernel/build" />

  <!-- Kleaf + rules -->
  <project path="build/kernel" name="kernel-build-kernel"
           remote="moto" revision="android-16-release-w1vo36.88-36-7">
    <linkfile src="kleaf/bazel.sh" dest="tools/bazel" />
    <linkfile src="kleaf/bzlmod/bazel.MODULE.bazel" dest="MODULE.bazel" />
    <linkfile src="kleaf/bzlmod/bazel.WORKSPACE.bzlmod" dest="WORKSPACE.bzlmod" />
  </project>

  <project path="build/bazel_common_rules"
           name="kernel_platform-build-bazel_common_rules"
           remote="moto" revision="android-16-release-w2we36.56-98-2" />

  <project path="build/bazel_mgk_rules" name="kernel-build-bazel_mgk_rules"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />

  <!-- Kernel + device modules.
       Untuk baseline MTK murni, jalankan reproduce-cleanup.sh (branch
       mtk-base-latest). Untuk port Infinix X6871, checkout branch
       w1vo36-6.12-port dari remote alps (lihat README.md). -->
  <project path="kernel-6.12" name="kernel-mtk"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="kernel_device_modules-6.12" name="kernel-kernel_device_modules-6.12"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />

  <!-- Vendor modules MTK terpadu:
       Berisi 6 repo Motorola w1vo36.88-36-7 (gpu, mtkcam, connectivity/
       conninfra, bt/linux_v2, bt/mt66xx, wlan/core/gen4m), 13 modul donor
       OPPO mt6896 (afs_common_utils, hbt_driver, hbt_driver_cus, met_drv_v3,
       sched_cus, connectivity/{common,connfem,fmradio,gps,wlan/adaptor,
       wlan/core/gen4-mt79xx,bt/linux_v2_ce,bt/mt76xx}), serta commit port
       Infinix X6871 (Mali r54p1-11eac0, camsys sink_fmt ABI, 4 sensor kamera
       + EEPROM). -->
  <project path="vendor/mediatek/kernel_modules"
           name="alps-vendor_mediatek_kernel_modules"
           remote="alps" revision="w1vo36-6.12-port" />
</manifest>
