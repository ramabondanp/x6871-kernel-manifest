<?xml version="1.0" encoding="UTF-8"?>
<!--
  Overlay untuk manifest AOSP:
    repo init -u https://android.googlesource.com/kernel/manifest \
              -b common-android16-6.12-2025-09
    cp local_manifest.xml .repo/local_manifests/w1vo.xml
    repo sync -j8

  Mengganti kernel/common dan kernel/build AOSP dengan versi w1vo,
  lalu menambah 9 repo w1vo lainnya.

  Catatan: tidak ada tag <default> di sini karena manifest AOSP sudah
  punya; revision/remote ditulis per project.
-->
<manifest>
  <remote name="moto" fetch="https://github.com/MotorolaMobilityLLC" />

  <remove-project name="kernel/common" />
  <remove-project name="kernel/build" />

  <project path="build/kernel" name="kernel-build-kernel"
           remote="moto" revision="android-16-release-w1vo36.88-36-7">
    <linkfile src="kleaf/bazel.sh" dest="tools/bazel" />
    <linkfile src="kleaf/bzlmod/bazel.MODULE.bazel" dest="MODULE.bazel" />
    <linkfile src="kleaf/bzlmod/bazel.WORKSPACE.bzlmod" dest="WORKSPACE.bzlmod" />
  </project>

  <project path="build/bazel_mgk_rules" name="kernel-build-bazel_mgk_rules"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />

  <project path="kernel-6.12" name="kernel-mtk"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="kernel_device_modules-6.12" name="kernel-kernel_device_modules-6.12"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="motorola/kernel/modules" name="motorola-kernel-modules"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />

  <project path="vendor/mediatek/kernel_modules/gpu"
           name="vendor-mediatek-kernel_modules-gpu"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="vendor/mediatek/kernel_modules/mtkcam"
           name="vendor-mediatek-kernel_modules-mtkcam"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="vendor/mediatek/kernel_modules/connectivity/conninfra"
           name="vendor-mediatek-kernel_modules-connectivity-conninfra"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="vendor/mediatek/kernel_modules/connectivity/bt/linux_v2"
           name="vendor-mediatek-kernel_modules-connectivity-bt-linux_v2"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="vendor/mediatek/kernel_modules/connectivity/bt/mt66xx"
           name="vendor-mediatek-kernel_modules-connectivity-bt-mt66xx"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
  <project path="vendor/mediatek/kernel_modules/connectivity/wlan/core/gen4m"
           name="vendor-mediatek-kernel_modules-connectivity-wlan-core-gen4m"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />
</manifest>
