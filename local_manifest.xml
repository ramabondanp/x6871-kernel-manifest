<?xml version="1.0" encoding="UTF-8"?>
<!--
  Overlay untuk manifest AOSP kernel (Infinix GT 20 Pro / X6871, MT6895):

  Jalankan dari root workspace kernel dengan repo manifest ini di
  ~/x6871-kernel-manifest (lihat README.md):

    repo init -u https://android.googlesource.com/kernel/manifest \
              -b common-android16-6.12-2026-09
    mkdir -p .repo/local_manifests
    cp ~/x6871-kernel-manifest/local_manifest.xml .repo/local_manifests/x6871.xml
    repo sync

  Mengganti kernel/build AOSP dengan Kleaf/MGK rules, mem-pin GKI murni ke
  tag android16-6.12-2026-09_r16 (6.12.92, KMI 6) di path kernel-6.12, dan
  menambahkan 2 repo port Infinix X6871:
    - 3 repo Kleaf/MGK build rules (build/kernel, bazel_common_rules, bazel_mgk_rules)
    - 1 repo GKI upstream AOSP (kernel/common @ android16-6.12-2026-09_r16, tanpa patch)
    - 2 repo port X6871 (alps-kernel_device_modules dan
      alps-vendor_mediatek_kernel_modules, keduanya di branch
      x6871-android16-6.12)

  Tidak ada tag <default> di sini karena manifest AOSP sudah punya;
  revision/remote ditulis per project. GKI dikunci ke tag, sedangkan
  proyek Motorola dan port X6871 mengikuti branch yang tertera.
-->
<manifest>
  <remote name="moto" fetch="https://github.com/MotorolaMobilityLLC" />
  <remote name="alps" fetch="https://github.com/ramabondanp" />

  <remove-project name="kernel/common" />
  <remove-project name="kernel/build" />

  <!-- Kleaf + rules -->
  <project path="build/kernel" name="kernel-build-kernel"
           remote="moto" revision="android-16-release-w1vo36.88-36-7">
    <linkfile src="kleaf/bazel.sh" dest="tools/bazel" />
    <linkfile src="kleaf/bzlmod/bazel.MODULE.bazel" dest="MODULE.bazel" />
    <linkfile src="kleaf/bzlmod/bazel.WORKSPACE.bzlmod" dest="WORKSPACE.bzlmod" />
  </project>

  <project path="build/bazel_common_rules"
           name="kernel_platform-build-bazel_common_rules"
           remote="moto" revision="android-16-release-w2we36.56-98-2" />

  <project path="build/bazel_mgk_rules" name="kernel-build-bazel_mgk_rules"
           remote="moto" revision="android-16-release-w1vo36.88-36-7" />

  <!-- GKI murni AOSP (tanpa edit) + device modules port Infinix X6871.
       Untuk build baseline MTK, lihat docs/guides/BUILD.md. -->
  <project path="kernel-6.12" name="kernel/common"
           remote="aosp" revision="refs/tags/android16-6.12-2026-09_r16" />
  <project path="kernel_device_modules-6.12" name="alps-kernel_device_modules"
           remote="alps" revision="x6871-android16-6.12" />

  <!-- Vendor modules MTK terpadu:
       Berisi 6 repo Motorola w1vo36.88-36-7 (gpu, mtkcam, connectivity/
       conninfra, bt/linux_v2, bt/mt66xx, wlan/core/gen4m), 13 modul donor
       OPPO mt6896 (afs_common_utils, hbt_driver, hbt_driver_cus, met_drv_v3,
       sched_cus, connectivity/{common,connfem,fmradio,gps,wlan/adaptor,
       wlan/core/gen4-mt79xx,bt/linux_v2_ce,bt/mt76xx}), serta commit port
       Infinix X6871 (Mali r54p1-11eac0, camsys sink_fmt ABI, 4 sensor kamera
       + EEPROM). -->
  <project path="vendor/mediatek/kernel_modules"
           name="alps-vendor_mediatek_kernel_modules"
           remote="alps" revision="x6871-android16-6.12" />
</manifest>
